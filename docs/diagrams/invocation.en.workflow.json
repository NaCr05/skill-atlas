      "variant": "emphasis"
    },
    {
      "id": "explicit_enhance",
      "from": "base_prompt",
      "to": "request_ai",
      "label": "Click Enhance",
      "variant": "dashed"
    },
    {
      "id": "enhance_request",
      "from": "request_ai",
      "to": "enhance_or_fallback",
      "label": "Check config",
      "variant": "dashed"
    },
    {
      "id": "enhanced_result",
      "from": "enhance_or_fallback",
      "to": "ready_gate",
      "label": "Return Prompt",
      "variant": "dashed"
