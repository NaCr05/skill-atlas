    {
      "id": "gate_denied",
      "from": "ready_gate",
      "to": "fix_readiness",
      "label": "review / setup",
      "variant": "security",
      "role": "error"
    }
  ],
  "semanticChecks": {
    "allowedRoots": [
      "scan"
    ],
    "allowedTerminals": [
      "paste_codex",
      "fix_readiness"
    ],
    "requiredEdges": [
      {
        "from": "base_prompt",
        "to": "ready_gate"
      },
      {
        "from": "base_prompt",
        "to": "request_ai"
      },
      {
        "from": "ready_gate",
        "to": "copy_prompt"
      }
    ],
    "requiredPaths": [
      {
        "from": "scan",
        "to": "paste_codex"
      }
    ]
  },
  "cards": [
    {
      "dot": "emerald",
      "title": "No API key required",
      "items": [
        "The browser builds the default Prompt after Skill selection.",
        "Copy and AI require readiness; successful copies record local usage."
      ]
    },
    {
      "dot": "amber",
      "title": "Enhancement has a local fallback",
      "items": [
        "OpenAI / DeepSeek are optional; no silent provider failover.",
        "Missing config, request failure or invalid output keeps the base Prompt."
      ]
    },
    {
      "dot": "cyan",
      "title": "Where this flow ends",
      "items": [
        "The user pastes into Codex and starts a separate task.",
        "Source: fc98b42; node-to-code mapping is in docs/diagrams."
      ]
    }
  ]
}
