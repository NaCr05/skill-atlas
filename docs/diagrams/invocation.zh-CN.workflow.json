  "cards": [
    {
      "dot": "emerald",
      "title": "无需 API Key 即可使用",
      "items": [
        "默认 Prompt 在浏览器生成，选择 Skill 就可预览。",
        "复制和 AI 增强均要求 ready；复制成功后记录本地使用。"
      ]
    },
    {
      "dot": "amber",
      "title": "增强失败仍保留本地结果",
