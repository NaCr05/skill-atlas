{
  "name": "skill-atlas",
  "version": "0.2.0",
  "private": true,
  "description": "A Windows-first local control panel for discovering, understanding, and safely using Codex Skills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaCr05/skill-atlas.git"
  },
  "homepage": "https://github.com/NaCr05/skill-atlas#readme",
  "bugs": {
    "url": "https://github.com/NaCr05/skill-atlas/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/startup/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "doctor": "node scripts/startup/launcher.mjs --check --no-browser",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.docs.config.ts",
    "package:windows:stage": "npm run build && node scripts/windows/package-windows.mjs --stage-only",
    "package:windows": "npm run build && node scripts/windows/package-windows.mjs",
    "verify:windows-stage": "node scripts/windows/verify-stage.mjs",
    "test:windows-installer": "node scripts/windows/smoke-installer.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
